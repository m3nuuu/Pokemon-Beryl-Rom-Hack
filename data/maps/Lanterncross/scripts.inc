Lanterncross_MapScripts::
	.byte 0

Lanterncross_EventScript_Sign1::
	msgbox Lanterncross_EventScript_Sign1_Text, MSGBOX_SIGN
	end

Lanterncross_EventScript_Sign1_Text:
	.string "LANTERNCROSS TEMPLE The road goes\n"
	.string "through the temple. Please walk\p"
	.string "quietly.$"

Lanterncross_EventScript_Sign2::
	msgbox Lanterncross_EventScript_Sign2_Text, MSGBOX_SIGN
	end

Lanterncross_EventScript_Sign2_Text:
	.string "LANTERN TOWER The lanterns are lit\n"
	.string "for those the river has taken.$"

Lanterncross_EventScript_Sign3::
	msgbox Lanterncross_EventScript_Sign3_Text, MSGBOX_SIGN
	end

Lanterncross_EventScript_Sign3_Text:
	.string "LETHYS PARK$"

Lanterncross_EventScript_Npc1::
	msgbox Lanterncross_EventScript_Npc1_Text, MSGBOX_NPC
	end

Lanterncross_EventScript_Npc1_Text:
	.string "Every year we float lanterns down\n"
	.string "the LETHYS. The river carries our\p"
	.string "thoughts to the ones we lost.$"

Lanterncross_EventScript_Npc2::
	msgbox Lanterncross_EventScript_Npc2_Text, MSGBOX_NPC
	end

Lanterncross_EventScript_Npc2_Text:
	.string "The park is the quietest place\n"
	.string "near the capital. Even the POKéMON\p"
	.string "whisper here.$"

Lanterncross_EventScript_Npc3::
	msgbox Lanterncross_EventScript_Npc3_Text, MSGBOX_NPC
	end

Lanterncross_EventScript_Npc3_Text:
	.string "Pika!$"

Lanterncross_EventScript_Npc4::
	msgbox Lanterncross_EventScript_Npc4_Text, MSGBOX_NPC
	end

Lanterncross_EventScript_Npc4_Text:
	.string "I come here to read. The capital\n"
	.string "is so loud!$"
